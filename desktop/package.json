{
  "name": "xelovoice-softphone",
  "productName": "XeloVoice Softphone",
  "version": "1.6.0",
  "description": "XeloVoice Windows softphone (WebRTC/WSS, with UDP/TCP/TLS registration).",
  "author": "Xelocorp",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --target=node18 --format=cjs --external:electron --outdir=dist/main",
    "build:renderer": "esbuild src/renderer/renderer.tsx --bundle --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/renderer/renderer.js && node scripts/copy-static.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sip.js": "^0.21.2",
    "typescript": "^5.6.3"
  }
}
