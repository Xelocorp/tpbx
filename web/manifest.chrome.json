{
  "manifest_version": 3,
  "name": "XeloVoice Softphone",
  "version": "1.0.0",
  "description": "WebRTC softphone for XeloVoice with background keep-alive.",
  "permissions": ["offscreen", "storage", "alarms", "notifications", "downloads"],
  "host_permissions": ["*://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "XeloVoice Softphone" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
